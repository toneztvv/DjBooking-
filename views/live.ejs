<%- include('partials/header', { page, title: 'DJXpress | Live Song Requests' }) %>

<section class="hero" style="padding: 60px 0 20px;">
  <div class="container">
    <div class="live-status">
      <span id="live-status-dot" class="pulse-dot <%= isLive ? '' : 'offline' %>"></span>
      <span id="live-status-label" class="live-badge <%= isLive ? '' : 'offline' %>">
        <%= isLive ? 'LIVE NOW' : 'OFFLINE' %>
      </span>
      <span id="guest-counter-pill" class="guest-counter-pill" style="display:none;">&#128101; <span id="guest-counter-count">0</span> here now</span>
    </div>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem);">Request a <span class="gradient">Song</span></h1>
    <p id="live-event-name" class="lead" style="display: <%= isLive && eventName ? 'block' : 'none' %>;">
      <%= eventName %>
    </p>
    <p class="lead" style="<%= isLive && eventName ? 'display:none;' : '' %>">
      Scan the QR code at the DJ booth or use this page to request a song while DJXpress is live.
    </p>
  </div>
</section>

<section style="padding-top: 0;">
  <div class="container">
    <div id="offline-notice" class="alert alert-info" style="display: <%= isLive ? 'none' : 'block' %>; max-width: 640px; margin: 0 auto 30px;">
      DJXpress isn't live right now. Check back during your event &mdash; this page updates automatically once requests open up.
    </div>

    <div id="now-playing" class="now-playing-card" style="display:none; margin-bottom: 30px;">
      <img id="now-playing-art" class="now-playing-art" src="" alt="" />
      <div>
        <div class="now-playing-label">NOW PLAYING</div>
        <div id="now-playing-title" class="now-playing-title"></div>
        <div id="now-playing-artist" class="now-playing-artist"></div>
        <div id="now-playing-dedication" class="now-playing-dedication" style="display:none;"></div>
      </div>
    </div>

    <div id="countdown-wrap" class="countdown-card" style="display:none;">
      <div id="countdown-label" class="countdown-label"></div>
      <div id="countdown-time" class="countdown-time"></div>
    </div>

    <div id="energy-wrap" class="energy-card" style="display:none;">
      <div class="energy-head">
        <span class="energy-title">&#128293; Crowd Energy</span>
        <span id="energy-label" class="energy-label"></span>
      </div>
      <div id="energy-bar" class="energy-bar" aria-hidden="true"></div>
    </div>

    <div id="battle-wrap" class="battle-card" data-interactive="1" style="display:none;">
      <div class="battle-head">
        <span class="battle-title">&#9876;&#65039; Song Battle &mdash; you decide what plays!</span>
        <span id="battle-timer" class="battle-timer"></span>
      </div>
      <div class="battle-sides">
        <button type="button" class="battle-side" id="battle-side-a">
          <span class="battle-song" id="battle-song-a"></span>
          <span class="battle-artist" id="battle-artist-a"></span>
          <span class="battle-bar"><span class="battle-fill" id="battle-fill-a"></span></span>
          <span class="battle-pct" id="battle-pct-a"></span>
        </button>
        <div class="battle-vs" aria-hidden="true">VS</div>
        <button type="button" class="battle-side" id="battle-side-b">
          <span class="battle-song" id="battle-song-b"></span>
          <span class="battle-artist" id="battle-artist-b"></span>
          <span class="battle-bar"><span class="battle-fill" id="battle-fill-b"></span></span>
          <span class="battle-pct" id="battle-pct-b"></span>
        </button>
      </div>
      <p id="battle-note" class="small-muted battle-note">Tap a song to vote. The winner goes straight into Up Next.</p>
    </div>
    <div id="battle-result" class="battle-result" style="display:none;"></div>

    <div id="tips-wrap" class="tips-card" style="display:none;">
      <h3 style="margin-top:0;">&#128184; Tip the DJ</h3>
      <p id="tips-message" class="small-muted" style="margin-bottom:14px;"></p>
      <div id="tips-buttons" class="tips-buttons"></div>
      <p id="tips-copied" class="small-muted" style="display:none; margin-top:10px;"></p>
    </div>

    <div id="request-form-wrap" style="display: <%= isLive ? 'block' : 'none' %>;">
      <div class="form-card">
        <h3 style="margin-top:0;">Send a Request</h3>
        <div id="form-message"></div>
        <form id="request-form">
          <div class="honeypot" aria-hidden="true">
            <label for="company_website">Website</label>
            <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
          </div>
          <div class="form-grid">
            <div class="field">
              <label for="requested_by">Your Name *</label>
              <input type="text" id="requested_by" name="requested_by" required maxlength="80" />
            </div>
            <div class="field">
              <label for="song_title">Song Title *</label>
              <input type="text" id="song_title" name="song_title" required maxlength="150" />
            </div>
          </div>
          <div class="form-grid">
            <div class="field">
              <label for="artist">Artist</label>
              <input type="text" id="artist" name="artist" maxlength="150" />
            </div>
            <div class="field">
              <label for="dedication">Shoutout / Dedication</label>
              <input type="text" id="dedication" name="dedication" maxlength="300" />
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Request Song</button>
        </form>
      </div>
    </div>

    <div id="reactions-wrap" style="display:none; margin-bottom: 30px;">
      <div class="form-card" style="max-width: 100%; text-align:center;">
        <h3 style="margin-top:0;">Send a Reaction</h3>
        <div class="reaction-bar">
          <button type="button" class="reaction-btn" data-emoji="🔥">🔥</button>
          <button type="button" class="reaction-btn" data-emoji="❤️">❤️</button>
          <button type="button" class="reaction-btn" data-emoji="🙌">🙌</button>
          <button type="button" class="reaction-btn" data-emoji="😂">😂</button>
          <button type="button" class="reaction-btn" data-emoji="👏">👏</button>
        </div>
        <div id="reaction-counts" class="reaction-counts"></div>
      </div>
    </div>
    <div id="reaction-float-layer" class="reaction-float-layer"></div>

    <div id="poll-wrap" style="display:none; margin-bottom: 30px;">
      <div class="form-card" style="max-width: 100%;">
        <h3 id="poll-question" style="margin-top:0;">&#128202;</h3>
        <div class="poll-bar-row">
          <div class="poll-bar-label" id="poll-label-a"></div>
          <div class="poll-bar-track"><div class="poll-bar-fill" id="poll-fill-a" style="width:0%;"></div></div>
        </div>
        <div class="poll-bar-row">
          <div class="poll-bar-label" id="poll-label-b"></div>
          <div class="poll-bar-track"><div class="poll-bar-fill" id="poll-fill-b" style="width:0%;"></div></div>
        </div>
        <div class="poll-vote-buttons" id="poll-vote-buttons">
          <button type="button" class="btn btn-secondary" id="poll-btn-a"></button>
          <button type="button" class="btn btn-secondary" id="poll-btn-b"></button>
        </div>
        <p id="poll-voted-note" class="small-muted" style="margin-top:10px; display:none;">Thanks for voting!</p>
      </div>
    </div>

    <div id="chat-wrap" style="display: <%= isLive ? 'block' : 'none' %>; margin-bottom: 30px;">
      <div class="form-card" style="max-width: 100%;">
        <h3 style="margin-top:0;">&#128172; Live Chat</h3>
        <p class="small-muted" style="margin-bottom:14px;">Chat with the DJ and everyone else here tonight &mdash; everyone sees every message.</p>
        <div id="chat-log" class="chat-log"></div>
        <div id="chat-empty" class="empty-state" style="display:none;">No messages yet &mdash; say hi!</div>
        <div id="chat-error" class="alert alert-error" style="display:none; margin-top:12px;"></div>
        <form id="chat-form" style="margin-top:14px; display:flex; gap:10px;">
          <input type="text" id="chat-message" name="message" placeholder="Type a message..." required maxlength="500" autocomplete="off" style="flex:1;" />
          <button type="submit" class="btn btn-primary">Send</button>
        </form>
      </div>
    </div>

    <div id="wall-wrap" style="display:none; margin-bottom: 30px;">
      <div class="form-card" style="max-width: 100%;">
        <h3 style="margin-top:0;">&#128248; Photo Wall</h3>
        <p class="small-muted" style="margin-bottom:14px;">Share a photo from tonight! The DJ checks every photo first, then it shows up on the Big Screen. Photos are shrunk automatically so they send fast.</p>
        <form id="wall-form">
          <div class="honeypot" aria-hidden="true">
            <label for="wall_company_website">Website</label>
            <input type="text" id="wall_company_website" name="company_website" tabindex="-1" autocomplete="off" />
          </div>
          <label class="btn btn-secondary btn-block wall-pick" for="wall-file">&#128247; Choose or take a photo</label>
          <input type="file" id="wall-file" accept="image/*" hidden />
          <img id="wall-preview" class="wall-preview" alt="Preview of your photo" hidden />
          <div class="form-grid" style="margin-top:14px;">
            <div class="field" style="margin-bottom:0;">
              <label for="wall-name">Your Name</label>
              <input type="text" id="wall-name" maxlength="60" />
            </div>
            <div class="field" style="margin-bottom:0;">
              <label for="wall-caption">Caption (optional)</label>
              <input type="text" id="wall-caption" maxlength="80" autocomplete="off" />
            </div>
          </div>
          <div id="wall-message" style="margin-top:12px;"></div>
          <button type="submit" id="wall-submit" class="btn btn-primary btn-block" style="margin-top:14px;" disabled>Send to the Wall</button>
        </form>
        <div id="wall-grid" class="wall-grid"></div>
        <div id="wall-empty" class="empty-state" style="display:none;">No photos on the wall yet &mdash; send the first one!</div>
      </div>
    </div>

    <div id="guestbook-wrap" style="display:none; margin-bottom: 30px;">
      <div class="form-card" style="max-width: 100%;">
        <h3 style="margin-top:0;">&#128213; Guestbook</h3>
        <p class="small-muted" style="margin-bottom:14px;">Leave a note for the night &mdash; these are kept as a keepsake.</p>
        <div id="guestbook-list"></div>
        <div id="guestbook-empty" class="empty-state" style="display:none;">No notes yet &mdash; be the first!</div>
        <div id="guestbook-error" class="alert alert-error" style="display:none; margin-top:12px;"></div>
        <form id="guestbook-form" style="margin-top:14px;">
          <div class="form-grid">
            <div class="field" style="margin-bottom:0;">
              <label for="guestbook-name">Your Name</label>
              <input type="text" id="guestbook-name" name="name" required maxlength="80" />
            </div>
            <div class="field" style="margin-bottom:0;">
              <label for="guestbook-message">Message</label>
              <input type="text" id="guestbook-message" name="message" required maxlength="500" autocomplete="off" />
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block" style="margin-top:14px;">Add to Guestbook</button>
        </form>
      </div>
    </div>

    <div class="board">
      <div class="card">
        <h3>&#127925; Up Next</h3>
        <p class="small-muted" style="margin-bottom:14px;">A green &#10003; Accepted means the DJ's confirmed it's coming up. Requested by more than one person? It stays as one row with everyone's name. Tap &#128077; to boost a song without requesting it again.</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Song</th>
                <th>Requested By</th>
                <th>First Requested</th>
                <th>Requests</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="pending-body">
              <tr class="skeleton-row"><td colspan="5"><span class="skeleton-bar"></span></td></tr>
              <tr class="skeleton-row"><td colspan="5"><span class="skeleton-bar"></span></td></tr>
            </tbody>
          </table>
          <div id="pending-empty" class="empty-state" style="display:none;">No requests yet &mdash; be the first!</div>
        </div>
      </div>

      <div class="card">
        <h3>&#9989; Recently Played</h3>
        <p class="small-muted" style="margin-bottom:14px;">"DJ Pick" means nobody requested it &mdash; just a track the DJ dropped anyway.</p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Song</th>
                <th>Requested By</th>
                <th>Played At</th>
                <th>Requests</th>
              </tr>
            </thead>
            <tbody id="played-body">
              <tr class="skeleton-row"><td colspan="4"><span class="skeleton-bar"></span></td></tr>
              <tr class="skeleton-row"><td colspan="4"><span class="skeleton-bar"></span></td></tr>
            </tbody>
          </table>
          <div id="played-empty" class="empty-state" style="display:none;">Nothing played yet tonight.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/effects.js"></script>
<script src="/js/moments.js"></script>
<script src="/js/extras.js"></script>
<script src="/js/wall.js"></script>
<script src="/js/live.js"></script>

<%- include('partials/footer') %>
