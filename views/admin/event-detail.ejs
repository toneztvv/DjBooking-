<%- include('../partials/header', { page, title: 'DJXpress Admin | ' + (event.name || 'Event') }) %>

<section style="padding-top: 40px;">
  <div class="container">
    <div class="flex-between" style="margin-bottom: 20px;">
      <div>
        <h1 style="margin:0 0 6px;"><%= event.name || 'Untitled Event' %></h1>
        <p class="small-muted" style="margin:0;">
          <%= event.started_at %> &mdash; <%= event.ended_at || 'still live' %>
        </p>
      </div>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="/admin/events" class="btn btn-secondary btn-sm">&larr; Back to Event History</a>
        <% if (event.id !== currentEventId) { %>
          <form method="POST" action="/admin/events/<%= event.id %>/delete"
            onsubmit="return confirm('Delete &quot;<%= (event.name || 'Untitled Event').replace(/"/g, '') %>&quot; and its entire setlist? This can\'t be undone.');">
            <button type="submit" class="btn btn-danger btn-sm">Delete Event</button>
          </form>
        <% } %>
      </div>
    </div>

    <div class="grid grid-3" style="margin-bottom: 30px;">
      <div class="card" style="text-align:center;">
        <h3 style="margin-bottom:6px;"><%= setlist.length %></h3>
        <p class="small-muted" style="margin:0;">Songs Played</p>
      </div>
      <div class="card" style="text-align:center;">
        <h3 style="margin-bottom:6px;"><%= stats.total_requests %></h3>
        <p class="small-muted" style="margin:0;">Total Requests</p>
      </div>
      <div class="card" style="text-align:center;">
        <h3 style="margin-bottom:6px;"><%= stats.requester_count %></h3>
        <p class="small-muted" style="margin:0;">Unique Requesters</p>
      </div>
    </div>

    <h2 style="font-size:1.2rem; margin-bottom:6px;">Setlist (in the order it was played)</h2>
    <p class="small-muted" style="margin-bottom:14px;">"DJ Pick" means nobody requested it &mdash; logged automatically so this is a complete record of the night.</p>
    <div class="card" style="margin-bottom: 30px;">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Song</th>
              <th>Requested By</th>
              <th>Played At</th>
              <th>Requests</th>
            </tr>
          </thead>
          <tbody>
            <% setlist.forEach(function(r, i) { %>
              <tr>
                <td class="small-muted"><%= i + 1 %></td>
                <td><strong><%= r.song_title %></strong><% if (r.artist) { %><br><span class="small-muted"><%= r.artist %></span><% } %></td>
                <td><%= r.requesters %></td>
                <td><%= r.played_at %></td>
                <td><span class="count-pill"><%= r.times_requested %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% if (!setlist.length) { %><div class="empty-state">Nothing was played during this event.</div><% } %>
      </div>
    </div>

    <h2 style="font-size:1.2rem; margin-bottom:14px;">Requested but never played</h2>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Song</th>
              <th>Requested By</th>
              <th>Requests</th>
            </tr>
          </thead>
          <tbody>
            <% neverPlayed.forEach(function(r) { %>
              <tr>
                <td><strong><%= r.song_title %></strong><% if (r.artist) { %><br><span class="small-muted"><%= r.artist %></span><% } %></td>
                <td><%= r.requesters %></td>
                <td><span class="count-pill"><%= r.times_requested %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% if (!neverPlayed.length) { %><div class="empty-state">Every requested song got played. 🎉</div><% } %>
      </div>
    </div>

    <h2 style="font-size:1.2rem; margin: 30px 0 14px;">Live Chat Log</h2>
    <div class="card" style="margin-bottom: 30px;">
      <div class="chat-log" style="max-height: 500px;">
        <% chatLog.forEach(function(m) { %>
          <div class="chat-bubble<% if (m.is_dj) { %> chat-bubble-dj<% } %>">
            <span class="chat-sender"><%= m.is_dj ? 'DJ' : m.sender_name %></span>
            <span class="chat-text"><%= m.message %></span>
            <span class="chat-time"><%= m.created_at %></span>
          </div>
        <% }); %>
      </div>
      <% if (!chatLog.length) { %><div class="empty-state">No chat messages during this event.</div><% } %>
    </div>

    <h2 style="font-size:1.2rem; margin-bottom:14px;">Quick Polls</h2>
    <div class="card" style="margin-bottom: 30px;">
      <% polls.forEach(function(p) { %>
        <% const total = p.votesA + p.votesB; %>
        <% const pctA = total ? Math.round((p.votesA / total) * 100) : 0; %>
        <% const pctB = total ? Math.round((p.votesB / total) * 100) : 0; %>
        <p class="small-muted" style="margin-bottom:6px;"><strong><%= p.question %></strong><% if (!p.closed_at) { %> &mdash; <span class="badge badge-live">Active</span><% } %></p>
        <div class="poll-bar-row">
          <div class="poll-bar-label"><%= p.option_a %> &mdash; <%= p.votesA %> (<%= pctA %>%)</div>
          <div class="poll-bar-track"><div class="poll-bar-fill" style="width: <%= pctA %>%;"></div></div>
        </div>
        <div class="poll-bar-row" style="margin-bottom: 24px;">
          <div class="poll-bar-label"><%= p.option_b %> &mdash; <%= p.votesB %> (<%= pctB %>%)</div>
          <div class="poll-bar-track"><div class="poll-bar-fill" style="width: <%= pctB %>%;"></div></div>
        </div>
      <% }); %>
      <% if (!polls.length) { %><div class="empty-state">No polls posted during this event.</div><% } %>
    </div>

    <h2 style="font-size:1.2rem; margin-bottom:14px;">Guestbook</h2>
    <div class="card">
      <% guestbookEntries.forEach(function(e) { %>
        <div class="guestbook-entry">
          <div class="gb-name"><%= e.name %></div>
          <div class="gb-message"><%= e.message %></div>
          <div class="gb-time"><%= e.created_at %></div>
        </div>
      <% }); %>
      <% if (!guestbookEntries.length) { %><div class="empty-state">No guestbook entries during this event.</div><% } %>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
