<%- include('../partials/header', { page, title: 'DJXpress Admin' }) %>

<section style="padding-top: 40px;">
  <div class="container">
    <div class="admin-header">
      <div>
        <h1 style="margin: 0 0 6px;">DJ Control Panel</h1>
        <p class="small-muted" style="margin:0;">Manage your live event, requests and bookings.</p>
      </div>
      <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <a href="/admin/events" class="btn btn-secondary btn-sm">Event History</a>
        <a href="/admin/guestbook" class="btn btn-secondary btn-sm">Guestbook</a>
        <a href="/admin/testimonials" class="btn btn-secondary btn-sm">Testimonials</a>
        <a href="/admin/gallery" class="btn btn-secondary btn-sm">Gallery</a>
        <a href="/admin/analytics" class="btn btn-secondary btn-sm">Analytics</a>
        <a href="/admin/services" class="btn btn-secondary btn-sm">Services &amp; Billing</a>
        <a href="/admin/setup-guide" class="btn btn-secondary btn-sm">Setup Guide</a>
        <div class="status-chip">
          <span class="pulse-dot <%= isLive ? '' : 'offline' %>" style="width:10px;height:10px;"></span>
          <%= isLive ? 'LIVE NOW' : 'OFFLINE' %>
        </div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 30px;">
      <h3>Live Page Features</h3>
      <p class="small-muted" style="margin-bottom:14px;">Turn any of these on or off for guests at any time &mdash; before, during, or after an event. Turning one off just hides it from guests; nothing already saved gets deleted, and turning it back on brings everything back.</p>
      <div class="feature-toggle-grid">
        <div class="feature-toggle-row">
          <div>
            <strong>Guest Counter</strong>
            <p class="small-muted" style="margin:2px 0 0;">Shows guests how many people are on the live page right now.</p>
          </div>
          <form method="POST" action="/admin/features/guest_counter/toggle">
            <button type="submit" class="btn btn-sm <%= features.guestCounter ? 'btn-success' : 'btn-ghost' %>"><%= features.guestCounter ? 'ON' : 'OFF' %></button>
          </form>
        </div>
        <div class="feature-toggle-row">
          <div>
            <strong>Live Reactions</strong>
            <p class="small-muted" style="margin:2px 0 0;">Tappable emoji buttons that float across everyone's screen.</p>
          </div>
          <form method="POST" action="/admin/features/reactions/toggle">
            <button type="submit" class="btn btn-sm <%= features.reactions ? 'btn-success' : 'btn-ghost' %>"><%= features.reactions ? 'ON' : 'OFF' %></button>
          </form>
        </div>
        <div class="feature-toggle-row">
          <div>
            <strong>Quick Polls</strong>
            <p class="small-muted" style="margin:2px 0 0;">Post a this-or-that question guests vote on live.</p>
          </div>
          <form method="POST" action="/admin/features/polls/toggle">
            <button type="submit" class="btn btn-sm <%= features.polls ? 'btn-success' : 'btn-ghost' %>"><%= features.polls ? 'ON' : 'OFF' %></button>
          </form>
        </div>
        <div class="feature-toggle-row">
          <div>
            <strong>Guestbook</strong>
            <p class="small-muted" style="margin:2px 0 0;">A wall of notes from guests, kept forever as a keepsake.</p>
          </div>
          <form method="POST" action="/admin/features/guestbook/toggle">
            <button type="submit" class="btn btn-sm <%= features.guestbook ? 'btn-success' : 'btn-ghost' %>"><%= features.guestbook ? 'ON' : 'OFF' %></button>
          </form>
        </div>
        <div class="feature-toggle-row">
          <div>
            <strong>Drops &amp; Countdowns</strong>
            <p class="small-muted" style="margin:2px 0 0;">Confetti, fireworks, shoutouts and "moment" countdowns you fire onto every screen.</p>
          </div>
          <form method="POST" action="/admin/features/effects/toggle">
            <button type="submit" class="btn btn-sm <%= features.effects ? 'btn-success' : 'btn-ghost' %>"><%= features.effects ? 'ON' : 'OFF' %></button>
          </form>
        </div>
        <div class="feature-toggle-row">
          <div>
            <strong>Energy Meter</strong>
            <p class="small-muted" style="margin:2px 0 0;">A crowd-energy meter you control from here, shown to guests.</p>
          </div>
          <form method="POST" action="/admin/features/energy/toggle">
            <button type="submit" class="btn btn-sm <%= features.energy ? 'btn-success' : 'btn-ghost' %>"><%= features.energy ? 'ON' : 'OFF' %></button>
          </form>
        </div>
      </div>
    </div>

    <div class="grid grid-2" style="margin-bottom: 30px;">
      <div class="card">
        <h3>Event Control</h3>
        <form method="POST" action="/admin/live/toggle"
          <% if (isLive) { %>onsubmit="return confirm('End the live event? Guests won\'t be able to send requests until you go live again.');"<% } %>>
          <% if (!isLive) { %>
            <div class="field">
              <label for="event_name">Event Name (optional)</label>
              <input type="text" id="event_name" name="event_name" maxlength="120" placeholder="e.g. Smith Wedding Reception" />
            </div>
            <button type="submit" class="btn btn-success btn-block">Go Live &amp; Start Fresh Board</button>
          <% } else { %>
            <p class="small-muted">Currently live<% if (eventName) { %>: <strong><%= eventName %></strong><% } %></p>
            <button type="submit" class="btn btn-danger btn-block">End Live Event</button>
          <% } %>
        </form>
        <form method="POST" action="/admin/requests/clear" style="margin-top: 12px;"
          onsubmit="return confirm('Clear the current request board? This starts a fresh board but keeps history.');">
          <button type="submit" class="btn btn-ghost btn-block btn-sm">Clear Board</button>
        </form>
      </div>

      <div class="card" style="text-align:center;">
        <h3>QR Code</h3>
        <p class="small-muted">Guests scan this to land on the homepage, where they can go to Book Now or Live Requests.</p>
        <div class="qr-box">
          <img src="/api/qrcode.png?size=400" alt="QR code linking to the live request page" />
        </div>
        <p class="small-muted" style="word-break: break-all; margin-top: 12px;"><%= liveUrl %></p>
        <a href="/api/qrcode/download" class="btn btn-secondary btn-sm">Download High-Res PNG</a>
        <a href="/screen" target="_blank" class="btn btn-primary btn-sm" style="margin-top:8px;">Open Big Screen Mode &#8599;</a>
      </div>

      <div class="card">
        <h3>Auto Song Detection</h3>
        <p class="small-muted">Listens through the mic every 30-90s and auto-marks matching requests as played &mdash; anything else played gets logged too, so the setlist is complete.</p>
        <p class="small-muted"><strong>Keep this tab open and visible the whole time</strong> &mdash; on a phone, switching apps or locking the screen pauses it (that's iOS/Android, not something a website can override). Works best left running on the laptop you're already DJing from; on a phone, dedicate one just to this, screen unlocked, propped up near the speakers.</p>
        <% if (isLive) { %>
          <button type="button" id="detect-start-btn" class="btn btn-success btn-block">Start Listening</button>
          <button type="button" id="detect-stop-btn" class="btn btn-danger btn-block" hidden>Stop Listening</button>
          <p id="detect-status" class="small-muted" style="margin-top:10px;">Not listening.</p>
        <% } else { %>
          <p class="small-muted"><em>Go live first to use auto-detect.</em></p>
        <% } %>
      </div>
    </div>

    <% if (isLive) { %>
    <div class="card" id="hype-card" style="margin-bottom: 30px;">
      <h3>&#9889; Hype Controls</h3>
      <p class="small-muted" style="margin-bottom:14px;">Fire things onto every guest's phone and the Big Screen the moment you tap them.</p>

      <% if (features.effects) { %>
      <h4 class="hype-heading">Drops</h4>
      <div class="hype-row">
        <button type="button" class="btn btn-primary btn-sm" data-drop="confetti">&#127881; Confetti</button>
        <button type="button" class="btn btn-primary btn-sm" data-drop="fireworks">&#127878; Fireworks</button>
        <button type="button" class="btn btn-primary btn-sm" data-drop="wash">&#10024; Color Wash</button>
      </div>

      <h4 class="hype-heading">Shoutout Banner</h4>
      <form id="shoutout-form" class="hype-row" style="flex-wrap:nowrap;">
        <input type="text" id="shoutout-text" maxlength="140" placeholder="e.g. Happy 16th Maria! &#127874;" style="flex:1; min-width:0;" />
        <button type="submit" class="btn btn-secondary btn-sm">Send</button>
      </form>

      <h4 class="hype-heading">Soundboard <span class="small-muted" style="font-weight:400;">(plays through the Big Screen's speakers)</span></h4>
      <div class="hype-row">
        <button type="button" class="btn btn-secondary btn-sm" data-drop="sound:airhorn">&#128226; Air Horn</button>
        <button type="button" class="btn btn-secondary btn-sm" data-drop="sound:siren">&#128680; Siren</button>
        <button type="button" class="btn btn-secondary btn-sm" data-drop="sound:cheer">&#128079; Crowd Cheer</button>
        <button type="button" class="btn btn-secondary btn-sm" data-drop="sound:scratch">&#128191; Scratch</button>
        <button type="button" class="btn btn-secondary btn-sm" data-drop="sound:drumroll">&#129345; Drum Roll</button>
        <button type="button" class="btn btn-secondary btn-sm" data-drop="sound:laser">&#128299; Laser</button>
      </div>
      <p class="small-muted" style="margin-top:8px;">Open <a href="/screen" target="_blank">Big Screen Mode</a> on a laptop/TV and click <strong>Enable sound</strong> once &mdash; sounds only play there, never on guests' phones.</p>

      <h4 class="hype-heading">Moment Countdown</h4>
      <form id="countdown-form" class="hype-row" style="flex-wrap:nowrap;">
        <input type="text" id="countdown-label-input" maxlength="60" placeholder="e.g. Cake cutting" style="flex:1; min-width:0;" />
        <input type="number" id="countdown-minutes" min="1" max="180" value="5" style="width:80px;" aria-label="Minutes" />
        <button type="submit" class="btn btn-secondary btn-sm">Start</button>
        <button type="button" id="countdown-clear" class="btn btn-ghost btn-sm">Clear</button>
      </form>
      <% } %>

      <% if (features.energy) { %>
      <h4 class="hype-heading">Crowd Energy: <span id="energy-readout"><%= energyLevel %></span>/10</h4>
      <input type="range" id="energy-slider" min="0" max="10" step="1" value="<%= energyLevel %>" class="energy-slider" aria-label="Crowd energy" />
      <% } %>

      <% if (!features.effects && !features.energy) { %>
        <p class="small-muted">Drops and the energy meter are both switched off in Live Page Features above.</p>
      <% } %>

      <p id="hype-status" class="small-muted" style="margin-top:12px; min-height:1.4em;" role="status"></p>
    </div>
    <% } %>

    <% if (isLive && features.polls) { %>
    <div class="card" style="margin-bottom: 30px;">
      <h3>&#128202; Quick Poll</h3>
      <% if (activePoll) { %>
        <p class="small-muted" style="margin-bottom:14px;"><%= activePoll.question %></p>
        <% const totalVotes = activePoll.votesA + activePoll.votesB; %>
        <% const pctA = totalVotes ? Math.round((activePoll.votesA / totalVotes) * 100) : 0; %>
        <% const pctB = totalVotes ? Math.round((activePoll.votesB / totalVotes) * 100) : 0; %>
        <div class="poll-bar-row">
          <div class="poll-bar-label"><%= activePoll.option_a %> &mdash; <%= activePoll.votesA %> (<%= pctA %>%)</div>
          <div class="poll-bar-track"><div class="poll-bar-fill" style="width: <%= pctA %>%;"></div></div>
        </div>
        <div class="poll-bar-row">
          <div class="poll-bar-label"><%= activePoll.option_b %> &mdash; <%= activePoll.votesB %> (<%= pctB %>%)</div>
          <div class="poll-bar-track"><div class="poll-bar-fill" style="width: <%= pctB %>%;"></div></div>
        </div>
        <form method="POST" action="/admin/polls/<%= activePoll.id %>/close" style="margin-top:14px;">
          <button type="submit" class="btn btn-danger btn-block btn-sm">Close Poll</button>
        </form>
      <% } else { %>
        <p class="small-muted" style="margin-bottom:14px;">Post a quick this-or-that question. Guests vote live and the results update automatically.</p>
        <form method="POST" action="/admin/polls">
          <div class="field">
            <label for="poll_question">Question</label>
            <input type="text" id="poll_question" name="question" maxlength="200" required placeholder="e.g. Next: Hip-Hop or Reggaeton?" />
          </div>
          <div class="form-grid">
            <div class="field">
              <label for="poll_option_a">Option A</label>
              <input type="text" id="poll_option_a" name="option_a" maxlength="60" required placeholder="Hip-Hop" />
            </div>
            <div class="field">
              <label for="poll_option_b">Option B</label>
              <input type="text" id="poll_option_b" name="option_b" maxlength="60" required placeholder="Reggaeton" />
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Post Poll</button>
        </form>
      <% } %>
    </div>
    <% } %>

    <% if (isLive) { %>
    <div class="card" style="margin-bottom: 30px;">
      <h3>&#128172; Live Chat</h3>
      <p class="small-muted" style="margin-bottom:14px;">Everyone at the event sees this &mdash; type a reply and it shows up on their phones in a few seconds. Messages with inappropriate language are automatically blocked before they're sent.</p>
      <div id="admin-chat-log" class="chat-log" style="max-height: 360px;"></div>
      <div id="admin-chat-empty" class="empty-state" style="display:none;">No messages yet tonight.</div>
      <div id="admin-chat-error" class="alert alert-error" style="display:none; margin-top:12px;"></div>
      <form id="admin-chat-form" style="margin-top:14px; display:flex; gap:10px;">
        <input type="text" id="admin-chat-message" placeholder="Reply to the crowd..." maxlength="500" required style="flex:1;" />
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
    </div>
    <% } %>

    <div class="flex-between" style="margin-bottom: 16px;">
      <h2 style="margin:0;">Booking Inquiries</h2>
      <a href="/admin/inquiries" class="btn btn-secondary btn-sm">
        View All <% if (newInquiries > 0) { %>(<%= newInquiries %> new)<% } %>
      </a>
    </div>

    <div class="board">
      <div class="card">
        <h3>&#127925; Up Next</h3>
        <p class="small-muted" style="margin-bottom:14px;">
          Songs requested by guests, most-requested first. <strong>Accept</strong> shows guests you've confirmed a song is coming up (it does not play it). <strong>Mark Played</strong> moves it to Recently Played once you actually play it. If the same song is requested by more than one guest, it stays as one row here with all their names listed &mdash; that's expected, not a duplicate bug.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Song</th>
                <th>Requested By</th>
                <th>Requests</th>
                <th>Upvotes</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% pending.forEach(function(r) { %>
                <tr>
                  <td>
                    <strong><%= r.song_title %></strong>
                    <% if (r.artist) { %><br><span class="small-muted"><%= r.artist %></span><% } %>
                    <% if (r.accepted) { %><br><span class="badge badge-booked">&#10003; Accepted</span><% } %>
                  </td>
                  <td><%= r.requesters %></td>
                  <td><span class="count-pill"><%= r.times_requested %></span></td>
                  <td><% if (r.upvotes) { %><span class="count-pill">&#128077; <%= r.upvotes %></span><% } else { %>&mdash;<% } %></td>
                  <td style="white-space:nowrap;">
                    <form method="POST" action="/admin/requests/accept" style="display:inline;">
                      <input type="hidden" name="normalized_key" value="<%= r.normalized_key %>" />
                      <% if (r.accepted) { %>
                        <input type="hidden" name="unaccept" value="1" />
                        <button type="submit" class="btn btn-ghost btn-sm">Unaccept</button>
                      <% } else { %>
                        <button type="submit" class="btn btn-secondary btn-sm">Accept</button>
                      <% } %>
                    </form>
                    <form method="POST" action="/admin/requests/mark-played" style="display:inline;">
                      <input type="hidden" name="normalized_key" value="<%= r.normalized_key %>" />
                      <button type="submit" class="btn btn-success btn-sm">Mark Played</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <% if (!pending.length) { %><div class="empty-state">No pending requests.</div><% } %>
        </div>
      </div>

      <div class="card">
        <h3>&#9989; Recently Played</h3>
        <p class="small-muted" style="margin-bottom:14px;">
          Everything played tonight. A song listed as requested by <strong>"DJ Pick"</strong> means nobody asked for it &mdash; Auto Song Detection (or you) played it anyway, and it's logged here so the setlist is complete.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Song</th>
                <th>Requested By</th>
                <th>Played At</th>
                <th>Requests</th>
              </tr>
            </thead>
            <tbody>
              <% recentlyPlayed.forEach(function(r) { %>
                <tr>
                  <td><strong><%= r.song_title %></strong><% if (r.artist) { %><br><span class="small-muted"><%= r.artist %></span><% } %></td>
                  <td><%= r.requesters %></td>
                  <td><%= r.played_at %></td>
                  <td><span class="count-pill"><%= r.times_requested %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <% if (!recentlyPlayed.length) { %><div class="empty-state">Nothing played yet.</div><% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (isLive) { %>
<script src="/js/detect.js"></script>
<script src="/js/admin-chat.js"></script>
<script src="/js/admin-hype.js"></script>
<% } %>

<%- include('../partials/footer') %>
