<%- include('../partials/header', { page, title: 'DJXpress Admin' }) %>

<section style="padding-top: 40px;">
  <div class="container">
    <div class="admin-header">
      <div>
        <h1 style="margin: 0 0 6px;">DJ Control Panel</h1>
        <p class="small-muted" style="margin:0;">Manage your live event, requests and bookings.</p>
      </div>
      <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
        <a href="/admin/events" class="btn btn-secondary btn-sm">Event History</a>
        <a href="/admin/services" class="btn btn-secondary btn-sm">Services &amp; Billing</a>
        <a href="/admin/setup-guide" class="btn btn-secondary btn-sm">Setup Guide</a>
        <div class="status-chip">
          <span class="pulse-dot <%= isLive ? '' : 'offline' %>" style="width:10px;height:10px;"></span>
          <%= isLive ? 'LIVE NOW' : 'OFFLINE' %>
        </div>
      </div>
    </div>

    <div class="grid grid-2" style="margin-bottom: 30px;">
      <div class="card">
        <h3>Event Control</h3>
        <form method="POST" action="/admin/live/toggle"
          <% if (isLive) { %>onsubmit="return confirm('End the live event? Guests won\'t be able to send requests until you go live again.');"<% } %>>
          <% if (!isLive) { %>
            <div class="field">
              <label for="event_name">Event Name (optional)</label>
              <input type="text" id="event_name" name="event_name" maxlength="120" placeholder="e.g. Smith Wedding Reception" />
            </div>
            <button type="submit" class="btn btn-success btn-block">Go Live &amp; Start Fresh Board</button>
          <% } else { %>
            <p class="small-muted">Currently live<% if (eventName) { %>: <strong><%= eventName %></strong><% } %></p>
            <button type="submit" class="btn btn-danger btn-block">End Live Event</button>
          <% } %>
        </form>
        <form method="POST" action="/admin/requests/clear" style="margin-top: 12px;"
          onsubmit="return confirm('Clear the current request board? This starts a fresh board but keeps history.');">
          <button type="submit" class="btn btn-ghost btn-block btn-sm">Clear Board</button>
        </form>
      </div>

      <div class="card" style="text-align:center;">
        <h3>QR Code</h3>
        <p class="small-muted">Guests scan this to open the live request page.</p>
        <div class="qr-box">
          <img src="/api/qrcode.png?size=400" alt="QR code linking to the live request page" />
        </div>
        <p class="small-muted" style="word-break: break-all; margin-top: 12px;"><%= liveUrl %></p>
        <a href="/api/qrcode/download" class="btn btn-secondary btn-sm">Download High-Res PNG</a>
      </div>

      <div class="card">
        <h3>Auto Song Detection</h3>
        <p class="small-muted">Listens through the mic every 30-90s and auto-marks matching requests as played &mdash; anything else played gets logged too, so the setlist is complete.</p>
        <p class="small-muted"><strong>Keep this tab open and visible the whole time</strong> &mdash; on a phone, switching apps or locking the screen pauses it (that's iOS/Android, not something a website can override). Works best left running on the laptop you're already DJing from; on a phone, dedicate one just to this, screen unlocked, propped up near the speakers.</p>
        <% if (isLive) { %>
          <button type="button" id="detect-start-btn" class="btn btn-success btn-block">Start Listening</button>
          <button type="button" id="detect-stop-btn" class="btn btn-danger btn-block" hidden>Stop Listening</button>
          <p id="detect-status" class="small-muted" style="margin-top:10px;">Not listening.</p>
        <% } else { %>
          <p class="small-muted"><em>Go live first to use auto-detect.</em></p>
        <% } %>
      </div>
    </div>

    <div class="flex-between" style="margin-bottom: 16px;">
      <h2 style="margin:0;">Booking Inquiries</h2>
      <a href="/admin/inquiries" class="btn btn-secondary btn-sm">
        View All <% if (newInquiries > 0) { %>(<%= newInquiries %> new)<% } %>
      </a>
    </div>

    <div class="board">
      <div class="card">
        <h3>&#127925; Up Next</h3>
        <p class="small-muted" style="margin-bottom:14px;">
          Songs requested by guests, most-requested first. <strong>Accept</strong> shows guests you've confirmed a song is coming up (it does not play it). <strong>Mark Played</strong> moves it to Recently Played once you actually play it. If the same song is requested by more than one guest, it stays as one row here with all their names listed &mdash; that's expected, not a duplicate bug.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Song</th>
                <th>Requested By</th>
                <th>Requests</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% pending.forEach(function(r) { %>
                <tr>
                  <td>
                    <strong><%= r.song_title %></strong>
                    <% if (r.artist) { %><br><span class="small-muted"><%= r.artist %></span><% } %>
                    <% if (r.accepted) { %><br><span class="badge badge-booked">&#10003; Accepted</span><% } %>
                  </td>
                  <td><%= r.requesters %></td>
                  <td><span class="count-pill"><%= r.times_requested %></span></td>
                  <td style="white-space:nowrap;">
                    <form method="POST" action="/admin/requests/accept" style="display:inline;">
                      <input type="hidden" name="normalized_key" value="<%= r.normalized_key %>" />
                      <% if (r.accepted) { %>
                        <input type="hidden" name="unaccept" value="1" />
                        <button type="submit" class="btn btn-ghost btn-sm">Unaccept</button>
                      <% } else { %>
                        <button type="submit" class="btn btn-secondary btn-sm">Accept</button>
                      <% } %>
                    </form>
                    <form method="POST" action="/admin/requests/mark-played" style="display:inline;">
                      <input type="hidden" name="normalized_key" value="<%= r.normalized_key %>" />
                      <button type="submit" class="btn btn-success btn-sm">Mark Played</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <% if (!pending.length) { %><div class="empty-state">No pending requests.</div><% } %>
        </div>
      </div>

      <div class="card">
        <h3>&#9989; Recently Played</h3>
        <p class="small-muted" style="margin-bottom:14px;">
          Everything played tonight. A song listed as requested by <strong>"DJ Pick"</strong> means nobody asked for it &mdash; Auto Song Detection (or you) played it anyway, and it's logged here so the setlist is complete.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Song</th>
                <th>Requested By</th>
                <th>Played At</th>
                <th>Requests</th>
              </tr>
            </thead>
            <tbody>
              <% recentlyPlayed.forEach(function(r) { %>
                <tr>
                  <td><strong><%= r.song_title %></strong><% if (r.artist) { %><br><span class="small-muted"><%= r.artist %></span><% } %></td>
                  <td><%= r.requesters %></td>
                  <td><%= r.played_at %></td>
                  <td><span class="count-pill"><%= r.times_requested %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
          <% if (!recentlyPlayed.length) { %><div class="empty-state">Nothing played yet.</div><% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (isLive) { %><script src="/js/detect.js"></script><% } %>

<%- include('../partials/footer') %>
