<%- include('../partials/header', { page, title: 'DJXpress Admin | Photo Passes' }) %>

<section style="padding-top: 40px;">
  <div class="container">
    <div class="flex-between" style="margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
      <h1 style="margin:0;">Photo Passes</h1>
      <a href="/admin" class="btn btn-secondary btn-sm">&larr; Back to Dashboard</a>
    </div>
    <p class="small-muted" style="margin-bottom: 24px; max-width: 760px;">
      A Photo Pass lets <strong>one guest</strong> upload photos to the Photo Wall <strong>forever</strong> (every future event too). Their phone remembers them automatically; if they switch phones they type their code (like <code>PASS-AB12CD</code>) &mdash; and you can look it up here if they lose it. Every photo still waits for your approval.
    </p>

    <div class="stats-row" style="max-width: 560px; margin: 0 0 24px;">
      <div class="stat-tile"><div class="stat-number"><%= totals.active %></div><div class="stat-label">Active passes</div></div>
      <div class="stat-tile"><div class="stat-number">$<%= (totals.cents / 100).toFixed(2) %></div><div class="stat-label">Sold (before Stripe fees)</div></div>
    </div>

    <% if (!passReady) { %>
      <div class="alert alert-info" style="max-width:760px;">Guests can't buy passes yet &mdash; connect Stripe and set a Photo Pass price on <a href="/admin/extras#payments">Tips &amp; Extras</a>. You can still give out free passes below.</div>
    <% } %>
    <% if (created) { %>
      <div class="alert alert-success" style="max-width:760px;">Free pass created. Give them this code: <strong style="letter-spacing:2px;"><%= created %></strong></div>
    <% } %>

    <div class="form-card" style="max-width:760px; margin-bottom: 30px;">
      <h3 style="margin-top:0;">&#127873; Give a free pass</h3>
      <p class="small-muted">For the host, a friend, someone who paid you in cash &mdash; whoever you want. They enter the code on the live page.</p>
      <form method="POST" action="/admin/passes">
        <div class="form-grid">
          <div class="field"><label for="pass-name">Name (so you remember)</label><input type="text" id="pass-name" name="name" maxlength="80" /></div>
          <div class="field"><label for="pass-email">Email (optional)</label><input type="email" id="pass-email" name="email" maxlength="200" /></div>
        </div>
        <button type="submit" class="btn btn-primary">Create Free Pass</button>
      </form>
    </div>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Code</th><th>Who</th><th>How</th><th>Photos sent</th><th>Created</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% passes.forEach(function(p) { %>
              <tr>
                <td><strong style="letter-spacing:1px;"><%= p.code %></strong></td>
                <td><%= p.name || '—' %><% if (p.email) { %><br><span class="small-muted"><%= p.email %></span><% } %></td>
                <td><%= p.source === 'stripe' ? 'Paid' + (p.amount_cents ? ' $' + (p.amount_cents / 100).toFixed(2) : '') : 'Free (you gave it)' %></td>
                <td><%= p.photo_count %></td>
                <td><%= p.created_at %></td>
                <td><span class="badge <%= p.status === 'active' ? 'badge-booked' : (p.status === 'pending' ? 'badge-contacted' : 'badge-declined') %>"><%= p.status === 'pending' ? 'checkout started' : p.status %></span></td>
                <td style="white-space:nowrap;">
                  <% if (p.status === 'active') { %>
                    <form method="POST" action="/admin/passes/<%= p.id %>/revoke" onsubmit="return confirm('Turn this pass off? They will no longer be able to upload photos.');"><button type="submit" class="btn btn-ghost btn-sm">Turn off</button></form>
                  <% } else if (p.status === 'revoked') { %>
                    <form method="POST" action="/admin/passes/<%= p.id %>/restore"><button type="submit" class="btn btn-secondary btn-sm">Turn back on</button></form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% if (!passes.length) { %><div class="empty-state">No passes yet.</div><% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
