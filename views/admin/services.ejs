<%- include('../partials/header', { page, title: 'DJXpress Admin | Services & Billing' }) %>

<section style="padding-top: 40px;">
  <div class="container">
    <div class="flex-between" style="margin-bottom: 8px;">
      <h1 style="margin:0;">Services &amp; Billing</h1>
    </div>
    <p class="small-muted" style="margin-bottom: 24px;">
      Every outside account this website depends on to run or stay paid up, in one place.
    </p>

    <div class="card" style="margin-bottom: 24px;">
      <h3 style="margin-top:0;">&#128190; Back Up Your Data</h3>
      <p class="small-muted">Everything this site remembers &mdash; bookings, requests, events, timelines, reviews, passes &mdash; lives in one file on the server. Download a copy now and then (before a big event is a good time) and keep it somewhere safe, like your email or a cloud drive. It contains your clients' contact details, so treat it as private.</p>
      <a href="/admin/backup/download" class="btn btn-primary btn-sm">Download a Backup</a>
      <p class="small-muted" style="margin:10px 0 0;">Photos you uploaded to the Gallery are separate files and aren't inside this backup. Guest photos from the Photo Wall are deleted on purpose after rejection and aren't kept.</p>
    </div>

    <div class="grid grid-2">
      <% services.forEach(function(s) { %>
        <div class="card">
          <h3 style="margin-bottom: 6px;"><%= s.name %></h3>
          <p class="small-muted" style="margin-bottom: 10px;"><%= s.purpose %></p>
          <p class="small-muted" style="margin-bottom: 16px;"><strong>Cost:</strong> <%= s.cost %></p>
          <% if (s.status) { %>
            <p style="margin-bottom: 16px;"><span class="badge badge-contacted"><%= s.status %></span></p>
          <% } %>
          <a href="<%= s.url %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm">
            Open <%= s.name %> Dashboard &rarr;
          </a>
        </div>
      <% }); %>
    </div>

    <div class="card" style="margin-top: 24px; text-align:center;">
      <h3 style="margin-bottom: 6px;">Full Setup Guide</h3>
      <p class="small-muted" style="margin-bottom: 16px;">A step-by-step record of everything that was built and subscribed to, so anyone can retrace or redo it.</p>
      <a href="/admin/setup-guide" class="btn btn-secondary btn-sm">View Setup Guide</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
