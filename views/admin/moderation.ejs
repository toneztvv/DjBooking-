<%- include('../partials/header', { page, title: 'DJXpress Admin | Chat Moderation' }) %>

<section style="padding-top: 40px;">
  <div class="container">
    <div class="flex-between" style="margin-bottom: 20px;">
      <h1 style="margin:0;">Chat Moderation</h1>
      <a href="/admin" class="btn btn-secondary btn-sm">&larr; Back to Dashboard</a>
    </div>

    <p class="small-muted" style="margin-bottom: 24px; max-width: 720px;">
      Live chat is anonymous, so a "banned chatter" here is identified by an
      invisible per-device ID, not a name. Anyone using a banned word/slur is
      removed automatically. You can also remove someone manually with the
      <strong>Ban</strong> button next to their message on the dashboard's Live
      Chat panel. Banned people can still see the chat, they just can't post
      to it anymore. Unban here any time, or edit the word list in
      <code>src/moderation.js</code> in the code.
    </p>

    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Banned At</th>
              <th>Reason</th>
              <th>Chatter ID</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% banned.forEach(function(b) { %>
              <tr>
                <td><%= b.banned_at %></td>
                <td><%= b.reason || '—' %></td>
                <td class="small-muted" style="max-width:220px; word-break:break-all;"><%= b.client_id %></td>
                <td>
                  <form method="POST" action="/admin/moderation/<%= b.id %>/unban"
                    onsubmit="return confirm('Let this person chat again?');">
                    <button type="submit" class="btn btn-secondary btn-sm">Unban</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% if (!banned.length) { %><div class="empty-state">Nobody's been banned from chat.</div><% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
