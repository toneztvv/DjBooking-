<%- include('partials/header', { page, title: 'Book DJXpress | Get a Quote' }) %>

<% if (typeof submitted === 'undefined' || !submitted) { %>
<section class="hero" style="padding: 60px 0 30px;">
  <div class="container">
    <span class="eyebrow">Booking Inquiry</span>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem);">Let's Book Your <span class="gradient">Event</span></h1>
    <p class="lead">Fill out the form below and DJXpress will follow up with availability and pricing.</p>
    <% if (typeof contact !== 'undefined' && contact.any) { %>
    <p class="small-muted book-contact">Prefer to talk? &nbsp;
      <% if (contact.phone) { %><a href="<%= contact.phoneHref %>">&#128222; Call</a> &middot; <a href="<%= contact.smsHref %>">&#128172; Text <%= contact.phone %></a><% } %>
      <% if (contact.email) { %><%= contact.phone ? ' · ' : '' %><a href="mailto:<%= contact.email %>">&#9993;&#65039; Email</a><% } %>
      <% if (contact.instagram) { %><%= (contact.phone || contact.email) ? ' · ' : '' %><a href="https://instagram.com/<%= contact.instagram %>" target="_blank" rel="noopener noreferrer">&#128247; Instagram</a><% } %>
    </p>
    <% } %>
  </div>
</section>
<% } else { %>
<div style="height: 28px;"></div>
<% } %>

<% if (typeof submitted !== 'undefined' && submitted) { %>
<section style="padding-top: 0;">
  <div class="container">
    <div class="confirm-panel" role="status">
      <div class="confirm-check" aria-hidden="true">&#10003;</div>
      <h2>You're on our list!</h2>
      <p class="lead" style="margin-bottom: 22px;">Thanks &mdash; your inquiry reached DJXpress. Expect a reply by email with availability and pricing (check your spam folder if you don't see it).</p>
      <ol class="confirm-steps">
        <li><strong>We check your date</strong> and reply with availability and a quote.</li>
        <li><strong>Once you're booked</strong>, you'll get a private planning page for your must-play songs, do-not-play list and timeline.</li>
        <li><strong>On the night</strong>, your guests scan a QR code to request songs, vote, dedicate and share photos.</li>
      </ol>
      <div class="hero-actions" style="margin-top: 26px;">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/live" class="btn btn-secondary">See How Live Requests Look</a>
        <a href="/book" class="btn btn-ghost">Send Another Inquiry</a>
      </div>
    </div>
  </div>
</section>
<% } else { %>

<% if (typeof error !== 'undefined' && error) { %>
<section style="padding-top: 0; padding-bottom: 0;">
  <div class="container">
    <div class="alert alert-error" role="alert" id="book-error" style="max-width: 640px; margin: 0 auto 24px;"><%= error %></div>
  </div>
</section>
<% } %>

<section style="padding-top: 0;">
  <div class="container">
    <div class="card reveal" style="max-width: 500px; margin: 0 auto 30px;">
      <div class="flex-between" style="margin-bottom: 10px;">
        <h3 style="margin:0;">Availability</h3>
        <div style="display:flex; gap:8px;">
          <button type="button" id="cal-prev" class="btn btn-ghost btn-sm">&larr;</button>
          <button type="button" id="cal-next" class="btn btn-ghost btn-sm">&rarr;</button>
        </div>
      </div>
      <p class="small-muted" style="margin-bottom:10px;">Tap an open date to fill it into the form below automatically.</p>
      <p id="cal-month-label" class="small-muted" style="margin-bottom:10px; text-align:center; font-weight:700;"></p>
      <div id="calendar-grid" class="calendar-grid"></div>
      <p class="small-muted" style="margin-top:12px; text-align:center;"><span class="cal-legend-dot cal-booked"></span> Already booked &nbsp; <span class="cal-legend-dot cal-open"></span> Open</p>
    </div>

    <% if (typeof referral !== 'undefined' && referral) { %>
    <div class="alert alert-success referral-banner">
      &#127873; <strong>Referral code <%= referral.code %> applied.</strong>
      <% if (referral.offer) { %> <%= referral.offer %><% } else { %> Thanks for coming through a friend!<% } %>
    </div>
    <% } %>

    <div class="form-card reveal">
      <form method="POST" action="/api/inquiries">
        <!-- Honeypot field, hidden from real users -->
        <div class="honeypot" aria-hidden="true">
          <label for="company_website">Website</label>
          <input type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-grid">
          <div class="field">
            <label for="name">Full Name *</label>
            <input type="text" id="name" name="name" required maxlength="120" autocomplete="name"
              value="<%= typeof values !== 'undefined' ? values.name : '' %>" />
          </div>
          <div class="field">
            <label for="email">Email *</label>
            <input type="email" id="email" name="email" required maxlength="200" autocomplete="email" inputmode="email"
              value="<%= typeof values !== 'undefined' ? values.email : '' %>" />
          </div>
        </div>

        <div class="form-grid">
          <div class="field">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" name="phone" maxlength="60" autocomplete="tel"
              value="<%= typeof values !== 'undefined' ? values.phone : '' %>" />
          </div>
          <div class="field">
            <label for="event_date">Event Date</label>
            <input type="date" id="event_date" name="event_date"
              value="<%= typeof values !== 'undefined' ? values.eventDate : '' %>" />
          </div>
        </div>

        <div class="form-grid">
          <div class="field">
            <label for="event_type">Event Type</label>
            <select id="event_type" name="event_type">
              <option value="">Select one</option>
              <option value="Wedding">Wedding</option>
              <option value="Quinceañera">Quinceañera</option>
              <option value="Sweet 16">Sweet 16</option>
              <option value="Birthday">Birthday</option>
              <option value="Comida / Family Gathering">Comida / Family Gathering</option>
              <option value="Back to School Bash">Back to School Bash</option>
              <option value="Corporate Event">Corporate Event</option>
              <option value="Club / Nightlife">Club / Nightlife</option>
              <option value="Private Party">Private Party</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div class="field">
            <label for="guest_count">Estimated Guest Count</label>
            <input type="text" id="guest_count" name="guest_count" maxlength="60" inputmode="numeric" placeholder="e.g. 120"
              value="<%= typeof values !== 'undefined' ? values.guestCount : '' %>" />
          </div>
        </div>

        <div class="field">
          <label for="location">Venue / Location</label>
          <input type="text" id="location" name="location" maxlength="200" autocomplete="off" placeholder="Venue name or city"
            value="<%= typeof values !== 'undefined' ? values.location : '' %>" />
        </div>

        <div class="field">
          <label for="message">Tell us about your event</label>
          <textarea id="message" name="message" rows="5" maxlength="2000"
            placeholder="Music style, timeline, special requests..."><%= typeof values !== 'undefined' ? values.message : '' %></textarea>
        </div>

        <div class="field">
          <label for="referral_code">Referral code <span class="small-muted">(optional &mdash; from a friend's event recap)</span></label>
          <input type="text" id="referral_code" name="referral_code" maxlength="20" placeholder="e.g. DJX-AB12C" autocomplete="off"
            value="<%= typeof values !== 'undefined' && values.referralCode ? values.referralCode : '' %>" />
        </div>

        <button type="submit" class="btn btn-primary btn-block" id="book-submit">Send Booking Inquiry</button>
      </form>
    </div>
  </div>
</section>

<% } %>

<script src="/js/book.js"></script>
<script src="/js/polish.js"></script>

<%- include('partials/footer') %>
