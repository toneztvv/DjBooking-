<%- include('partials/header', { page, title: 'DJXpress | Professional DJ for Weddings & Events' }) %>

<section class="hero">
  <div class="container">
    <span class="eyebrow">Weddings &bull; Parties &bull; Clubs &bull; Corporate</span>
    <h1>DJ<span class="gradient">Xpress</span> keeps<br>the dance floor moving.</h1>
    <p class="lead">
      Professional DJ services for weddings, birthdays, private parties and nightlife.
      Book your date, browse the vibe, and once the party starts &mdash; request your song live from your phone.
    </p>
    <div class="hero-actions">
      <a href="/book" class="btn btn-primary">Book Your Event</a>
      <a href="/live" class="btn btn-secondary">See Live Requests</a>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-title">
      <h2>What DJXpress Brings</h2>
      <p>Every event gets a custom-tailored set, top-tier sound, and a crowd that never stops moving.</p>
    </div>
    <div class="grid grid-3">
      <div class="card">
        <div class="icon-badge">&#127925;</div>
        <h3>Any Genre, Any Crowd</h3>
        <p>Hip-Hop, R&amp;B, Top 40, Latin, Reggaeton, House, Afrobeats, Old School &mdash; blended live to read the room.</p>
      </div>
      <div class="card">
        <div class="icon-badge">&#128241;</div>
        <h3>Live Song Requests</h3>
        <p>Guests scan a QR code at the event and request songs right from their phone &mdash; no more shouting over the music.</p>
      </div>
      <div class="card">
        <div class="icon-badge">&#127775;</div>
        <h3>Pro Sound &amp; Lighting</h3>
        <p>Clean, powerful sound and dance-floor lighting that scales from an intimate party to a full ballroom.</p>
      </div>
    </div>
  </div>
</section>

<section class="card" style="max-width: var(--max-width); margin: 0 auto;">
  <div class="container" style="padding: 20px 0;">
    <div class="section-title">
      <h2>Music For Every Occasion</h2>
      <p>A sample of what DJXpress spins &mdash; the full set is always shaped around your crowd and your requests.</p>
    </div>
    <div class="tag-list">
      <span class="tag">Weddings</span>
      <span class="tag">Quinceañeras</span>
      <span class="tag">Birthdays</span>
      <span class="tag">Corporate Events</span>
      <span class="tag">Club Nights</span>
      <span class="tag">Hip-Hop &amp; R&amp;B</span>
      <span class="tag">Top 40</span>
      <span class="tag">Latin &amp; Reggaeton</span>
      <span class="tag">House &amp; EDM</span>
      <span class="tag">Old School Classics</span>
      <span class="tag">Open Format</span>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-title">
      <h2>How Live Requests Work</h2>
      <p>When DJXpress is live at your event, guests can request songs in seconds.</p>
    </div>
    <div class="grid grid-3">
      <div class="card">
        <div class="icon-badge">1</div>
        <h3>Scan the QR Code</h3>
        <p>Posted at the DJ booth &mdash; scan it with any phone camera, no app needed.</p>
      </div>
      <div class="card">
        <div class="icon-badge">2</div>
        <h3>Request a Song</h3>
        <p>Type the song, your name, and an optional shoutout or dedication.</p>
      </div>
      <div class="card">
        <div class="icon-badge">3</div>
        <h3>Watch It Live</h3>
        <p>See the request board update in real time &mdash; who requested what, and how many times it's been requested.</p>
      </div>
    </div>
    <div style="text-align:center; margin-top: 34px;">
      <a href="/live" class="btn btn-primary">View the Live Board</a>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="card" style="text-align:center; padding: 50px 30px;">
      <h2 style="margin-top:0;">Ready to book DJXpress for your event?</h2>
      <p class="small-muted" style="max-width:500px; margin: 0 auto 24px;">
        Tell us about your event and we'll get back to you with availability and pricing.
      </p>
      <a href="/book" class="btn btn-primary">Start Your Booking</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
