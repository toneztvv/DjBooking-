# Copy this file to .env and fill in real values before running in production.

PORT=3000

# The public URL of your live site once deployed (used for the QR code
# and share links). During local testing this can stay as localhost.
SITE_URL=http://localhost:3000

# Credentials for the /admin dashboard (booking inquiries, live board control,
# QR code, mark songs as played). CHANGE THESE before going live.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme123

# Optional: email yourself a notification every time someone submits a
# booking inquiry, sent via your own Gmail account. Leave both blank to
# skip email notifications entirely (inquiries still show up in /admin).
# GMAIL_USER must be a full Gmail address; GMAIL_APP_PASSWORD is a 16-character
# App Password from https://myaccount.google.com/apppasswords (requires
# 2-Step Verification enabled on the account) — your regular Gmail password
# will NOT work here. See README for full setup steps.
GMAIL_USER=
GMAIL_APP_PASSWORD=
