# Copy this file to .env and fill in real values before running in production.

PORT=3000

# The public URL of your live site once deployed (used for the QR code
# and share links). During local testing this can stay as localhost.
SITE_URL=http://localhost:3000

# Credentials for the /admin dashboard (booking inquiries, live board control,
# QR code, mark songs as played). CHANGE THESE before going live.
ADMIN_USER=admin
ADMIN_PASSWORD=changeme123

# Optional: email a notification every time someone submits a booking
# inquiry. Sent via Resend (resend.com free tier — 3,000 emails/month, no
# credit card needed) rather than raw SMTP, since most hosts block or time
# out direct SMTP connections. Leave both blank to skip email notifications
# entirely (inquiries still show up in /admin either way).
# RESEND_API_KEY: create a free Resend account, then an API key at
#   https://resend.com/api-keys
# GMAIL_USER: the email address that should RECEIVE the notifications
#   (despite the name, this can be any address — it doesn't need to be Gmail)
# See README for full setup steps.
RESEND_API_KEY=
GMAIL_USER=

# Optional: automatic song detection. When set, the admin dashboard shows a
# "Start Listening" button that samples audio from the DJ laptop's mic every
# 30-90s, identifies the song via AudD (audd.io), auto-marks matching
# requests as played, and logs anything else played too (so the event
# history is a complete tracklist, not just fulfilled requests). Leave
# blank to skip this entirely — manually clicking "Mark Played" still works
# exactly as before.
# AUDD_API_KEY: create a free account at https://audd.io (300 free
#   recognitions, no card needed), then grab a key from your account page.
#   After that it's pay-as-you-go, about $5 per 1,000 recognitions.
AUDD_API_KEY=
